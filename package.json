{
    "name": "lambda-api",
    "version": "1.0.0",
    "main": "lambda.js",
    "scripts": {
        "start": "node src/server.js",
        "start:offline": "serverless offline --stage dev --config config/serverless.yml",
        "test": "jest --coverage",
